# Express runtime mode. Allowed values: development, test, production.
NODE_ENV=development

# HTTP port. Render and other hosts may provide PORT automatically.
PORT=3001

# Browser origins allowed to call this API; separate multiple origins with commas.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Supabase project URL from Project Settings > API.
SUPABASE_URL=https://your-project-ref.supabase.co

# Public Supabase key for server-side user-scoped operations.
SUPABASE_ANON_KEY=your-supabase-publishable-key

# Privileged key for server-only operations. Replace only in an untracked .env
# or deployment secret store; never commit a real value or expose it to the client.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-secret

# Gemini API key, stored only on this server or in the deployment secret store.
GEMINI_API_KEY=replace-with-gemini-api-key

# Gemini model ID used for chat generation.
GEMINI_CHAT_MODEL=your-gemini-chat-model

# Gemini embedding model ID; use the same model for indexing and retrieval.
GEMINI_EMBEDDING_MODEL=your-gemini-embedding-model

# Embedding vector size; this must match the pgvector column definition.
EMBEDDING_DIMENSIONS=1536