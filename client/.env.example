# Public client configuration. Vite exposes VITE_* variables in the browser bundle.
# Do not put API keys or privileged server credentials in this file.

# Express API origin, without a trailing slash. Local development default:
VITE_API_URL=http://localhost:3001

# Supabase project URL from Project Settings > API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable/anon key. This is intentionally a public placeholder.
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key